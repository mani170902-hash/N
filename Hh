<span class="comment">    # Y + D + ((W - 1) * DY) + M + 1</span>
    
    x_old_component = (
        Y <span class="operator">+</span> D <span class="operator">+</span> 
        ((W <span class="operator">-</span> <span class="number">1</span>) <span class="operator">*</span> DY) <span class="operator">+</span> 
        M <span class="operator">+</span> <span class="number">1</span>
    )

<span class="comment">    # Intermediate SUM (L174): [ X_Old + D_sum^3 + P1^2 + 17 ] * 3</span>
    intermediate_sum = (
        x_old_component <span class="operator">+</span> 
        D_sum_cubed <span class="operator">+</span>
        P1_squared <span class="operator">+</span>
        <span class="number">17</span>
    ) <span class="operator">*</span> <span class="number">3</span>
    
    <span class="keyword">return</span> <span class="function">format_password</span>(intermediate_sum)

