<span class="comment"># The constant used for the XOR operation in calNewest</span>
<span class="constant">XOR_CONST</span> = <span class="number">36873</span>

<span class="keyword">def</span> <span class="function">get_base_values</span>(serial_number: <span class="string">str</span>):
<span class="string">    """
    Extracts date-independent values (digit sum and product factors) 
    from the 5-digit serial number.
    """</span>
    
<span class="comment">    # Input is guaranteed to be 5 digits by the main function's validation.</span>
    
<span class="comment">    # j9 equivalent (Sum of all 5 digits, L172/L197 in Java)</span>
    digit_sum = <span class="function">sum</span>(<span class="function">int</span>(d) <span class="keyword">for</span> d <span class="keyword">in</span> serial_number)
    digit_sum_cubed = digit_sum <span class="operator">**</span> <span class="number">3</span>

<span class="comment">    # P1: Digits at indices 0, 2, 4 (d1 d3 d5) -> str.charAt(0), str.charAt(2), str.charAt(4)</span>
    p1_str = serial_number[<span class="number">0</span>] <span class="operator">+</span> serial_number[<span class="number">2</span>] <span class="operator">+</span> serial_number[<span class="number">4</span>]
    p1_val = <span class="function">int</span>(p1_str)
    
<span class="comment">    # P2: Digits at indices 4, 2, 0 (d5 d3 d1) -> str.charAt(4), str.charAt(2), str.charAt(0)</span>
    p2_str = serial_number[<span class="number">4</span>] <span class="operator">+</span> serial_number[<span class="number">2</span>] <span class="operator">+</span> serial_number[<span class="number">0</span>]
    p2_val = <span class="function">int</span>(p2_str)
    
<span class="comment">    # P1_P2_product: Used in calNewest</span>
    p1_p2_product = p1_val <span class="operator">*</span> p2_val
    
<span class="comment">    # P1_squared: Used in calNew</span>
    p1_squared = p1_val <span class="operator">**</span> <span class="number">2</span>
    
    <span class="keyword">return</span> digit_sum_cubed, p1_p2_product, p1_squared, p1_val

<span class="keyword">def</span> <span class="function">get_date_values</span>():
<span class="string">    """
    Extracts date values, compensating for the Android Time object's indexing.
    """</span>
    now = datetime.datetime.<span class="function">now</span>()
    
    year = now.<span class="function">year</span>          <span class="comment"># i</span>
    month = now.<span class="function">month</span>        <span class="comment"># i2 (Python's month is 1-indexed, matching Java's time.month + 1)</span>
    day = now.<span class="function">day</span>            <span class="comment"># i3</span>
    
<span class="comment">    # i4: Day of Week (Mon=1 to Sun=7) - Matches Java's adjusted range (1-7).</span>
    day_of_week_adjusted = now.<span class="function">isoweekday</span>() 
    day_of_week_squared = day_of_week_adjusted <span class="operator">**</span> <span class="number">2</span> <span class="comment"># i4 * i4</span>

<span class="comment">    # i5 + 1: Day of Year (1 to 366) - Matches Java's (time.yearDay + 1) term.</span>
    day_of_year_1_indexed = now.<span class="function">timetuple</span>().<span class="function">tm_yday</span>
    
    <span class="keyword">return</span> year, month, day, day_of_week_adjusted, day_of_year_1_indexed

<span class="keyword">def</span> <span class="function">format_password</span>(final_value: <span class="string">int</span>) -> <span class="string">str</span>:
<span class="string">    """
    Applies the final 5-digit reversal and padding logic (L149, L175, L199).
    """</span>
    
<span class="comment">    # 1. Get the last 5 digits of the final_value</span>
    five_digits = final_value <span class="operator">%</span> <span class="number">100000</span>
    
<span class="comment">    # 2. Convert to a 5-digit zero-padded string (e.g., 01234)</span>
<span class="comment">    # Ensure it remains an integer for formatting</span>
    padded_digits = <span class="string">f"{int(five_digits):05d}"</span>
    
<span class="comment">    # 3. Reverse the string (This is the reversal logic from the Java math)</span>
    reversed_password = padded_digits[<span class="string">::-1</span>]

    <span class="keyword">return</span> reversed_password

<span class="keyword">def</span> <span class="function">calNewest</span>(serial: <span class="string">str</span>, values):
<span class="string">    """Generates password using the V3.0 algorithm."""</span>
    Y, M, D, W, DY = values[<span class="string">'date'</span>]
    D_sum_cubed, P1_P2_product, _, _ = values[<span class="string">'serial'</span>]

<span class="comment">    # Intermediate SUM (L198)</span>
<span class="comment">    # SUM = [ (M * D) + Y ] + [ D_sum^3 ] + [ W^2 ] + [ DY ] + [ P1 * P2 ]</span>
    intermediate_sum = (
        (M <span class="operator">*</span> D) <span class="operator">+</span> Y <span class="operator">+</span>
        D_sum_cubed <span class="operator">+</span>
        (W <span class="operator">**</span> <span class="number">2</span>) <span class="operator">+</span>
        DY <span class="operator">+</span>          
        P1_P2_product
    )
    
<span class="comment">    # Final XOR operation</span>
    final_value = <span class="constant">XOR_CONST</span> <span class="operator">^</span> intermediate_sum
    
    <span class="keyword">return</span> <span class="function">format_password</span>(final_value), intermediate_sum

<span class="keyword">def</span> <span class="function">calNew</span>(serial: <span class="string">str</span>, values):
<span class="string">    """Generates password using the V2.0 algorithm."""</span>
    Y, M, D, W, DY = values[<span class="string">'date'</span>]
    D_sum_cubed, _, P1_squared, P1_val = values[<span class="string">'serial'</span>]

